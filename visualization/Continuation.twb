    <dashboard enable-sort-zone-taborder='true' name='Presence of cemeteries'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='26168' id='3' name='Presence of cemeteries in Early Helladic Period' w='70858' x='196' y='818' />
        <zone h='33294' id='4' name='Presence of cemeteries in Middle Helladic' w='71513' x='-131' y='20678' />
        <zone h='22196' id='5' type-v2='text' w='40275' x='2030' y='46145'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>In contrast to settlements, the presence of cemeteries decreases from the Early to the Middle Helladic period.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='14'>This may indicate changes in burial practices or in the spatial organization of habitation and mortuary activity.</run>
          </formatted-text>
        </zone>
      </zones>
