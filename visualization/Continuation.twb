            <column caption='Calculation1' datatype='real' name='[Calculation_1423645581574145]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;IF (LOWER(TRIM([Early_Helladic])) = &quot;yes&quot; OR LOWER(TRIM([Early_Helladic])) = &quot;possible&quot;)&#13;&#10;AND (LOWER(TRIM([Middle_Helladic])) = &quot;yes&quot; OR LOWER(TRIM([Middle_Helladic])) = &quot;possible&quot;)&#13;&#10;THEN [site_no]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;IF (LOWER(TRIM([Early_Helladic])) = &quot;yes&quot; OR LOWER(TRIM([Early_Helladic])) = &quot;possible&quot;)&#13;&#10;THEN [site_no]&#13;&#10;END&#13;&#10;)' />
