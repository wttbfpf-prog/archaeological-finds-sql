        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF ([Early_Helladic] = &quot;yes&quot; OR [Early_Helladic] = &quot;possible&quot;)&#13;&#10;AND ([Middle_Helladic] = &quot;yes&quot; OR [Middle_Helladic] = &quot;possible&quot;)&#13;&#10;THEN [site_no]&#13;&#10;END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD(&#13;&#10;IF ([Early_Helladic] = &quot;yes&quot; OR [Early_Helladic] = &quot;possible&quot;)&#13;&#10;THEN [site_no]&#13;&#10;END&#13;&#10;)' />
