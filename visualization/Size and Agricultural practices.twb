      <column caption='Continuation' datatype='string' name='[Calculation_1423645566160896]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF (&#13;&#10;    LOWER(TRIM([Early_Helladic])) = &quot;yes&quot; OR LOWER(TRIM([Early_Helladic])) = &quot;possible&quot;&#13;&#10;) THEN &quot;Early&quot;&#13;&#10;&#13;&#10;ELSEIF  (&#13;&#10;    LOWER(TRIM([Middle_Helladic])) = &quot;yes&quot; OR LOWER(TRIM([Middle_Helladic])) = &quot;possible&quot;&#13;&#10;) THEN &quot;Middle&quot;&#13;&#10;ELSE &quot;None&quot;&#13;&#10;END' />
